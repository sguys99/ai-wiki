{
  "name": "ai-wiki-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages site generator for ai-wiki (Constellation design)",
  "scripts": {
    "build": "node build.mjs",
    "build:deploy": "BASE=/ai-wiki node build.mjs && pagefind --site ../dist",
    "pagefind": "pagefind --site ../dist",
    "preview": "node build.mjs && pagefind --site ../dist && serve ../dist -l 4173",
    "serve": "serve ../dist -l 4173"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "serve": "^14.2.4"
  }
}
